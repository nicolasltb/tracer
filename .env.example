# =============================================================================
# Docker Compose — variáveis de ambiente
# Copie para .env e preencha os valores antes de rodar: cp .env.example .env
# =============================================================================

# ─── Banco de Dados ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-a-senha
POSTGRES_DB=coffee_trace

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-de-pelo-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Wallet / Criptografia ────────────────────────────────────────────────────
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=gere-uma-chave-fernet-aqui

# ─── Blockchain (Hyperledger Besu) ────────────────────────────────────────────
# Local dev (outside Docker): http://localhost:8545
# Inside Docker Compose: overridden to http://besu-node1:8545 in docker-compose.yml
BESU_RPC_URL=http://localhost:8545
BESU_CHAIN_ID=1337
# Auto-set by the deployer service in docker compose.
# Only needed for manual runs outside Docker.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Conta com saldo pré-alocado no genesis. Usada para deploy do contrato e
# para pré-fundar wallets de novos usuários no registro (sem isso o Besu QBFT
# descarta silenciosamente as tx de contas com saldo 0).
# Dev default (Hardhat #0, casa com besu/genesis.json):
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Em produção, gere um novo par e pré-aloque o saldo no genesis.json.
FAUCET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
FAUCET_FUND_WEI=1000000000000000000

# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
